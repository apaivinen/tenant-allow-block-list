{
	"name": "Exchange Online PowerShell",
	"image": "mcr.microsoft.com/powershell:lts-ubuntu-22.04",
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {}
	},
	"postCreateCommand": "pwsh -NoProfile -Command \"Install-Module -Name ExchangeOnlineManagement -Scope AllUsers -Force -Repository PSGallery\"",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.powershell"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "pwsh",
				"terminal.integrated.profiles.linux": {
					"pwsh": {
						"path": "pwsh"
					}
				}
			}
		}
	},
	"remoteUser": "vscode"
}
